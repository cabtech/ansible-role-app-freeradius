---

ignore: |
  virtualenv/
  venv/
  .venv/

extends: default

rules:
  document-end:
    level: error
    present: true
  comments-indentation: disable
  indentation: disable
  line-length: disable
  colons:
    ignore: |
     group_vars/all.yml
  commas:
    ignore: |
     group_vars/all.yml
  document-start:
    level: error
    present: true
    ignore: |
      dummy.yml
...
